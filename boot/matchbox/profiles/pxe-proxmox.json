{
  "id": "pxe-proxmox",
  "name": "Proxmox VE 9.2 Unattended Install",
  "ignition_id": "",
  "boot": {
    "kernel": "/assets/linux26",
    "initrd": [
      "/assets/initrd.img"
    ],
    "args": [
      "initrd=initrd.img",
      "vga=788",
      "proxmox-auto-install-answer-file-url={{ .url }}/assets/answers/{{ .group.id }}.toml",
      "proxmox-auto-install-answer-file-url-cert-fingerprint=",
      "quiet"
    ]
  }
}
