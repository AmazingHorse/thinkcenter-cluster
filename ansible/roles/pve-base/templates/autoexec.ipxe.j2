#!/ipxe
dhcp || goto failed
echo Booting Proxmox VE over TFTP...
kernel tftp://{{ cluster.boot_server_ip }}/linux26 initrd=initrd.img vga=788 proxmox-auto-install-answer-file-url=http://{{ cluster.boot_server_ip }}:8080/assets/answers/${mac:hexhyp}.toml proxmox-auto-install-answer-file-url-cert-fingerprint= quiet || goto failed
initrd tftp://{{ cluster.boot_server_ip }}/initrd.img || goto failed
boot || goto failed

:failed
echo iPXE boot failed. Pausing 30 seconds...
sleep 30
