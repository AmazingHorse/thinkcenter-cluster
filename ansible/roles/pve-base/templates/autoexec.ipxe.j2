#!ipxe
echo Booting Proxmox VE automated installer over HTTP...
kernel http://{{ cluster.boot_server_ip }}:8080/assets/linux26 initrd=initrd.img ramdisk_size=2097152 vga=788 ip=any:dhcp quiet || goto failed
initrd http://{{ cluster.boot_server_ip }}:8080/assets/initrd.img || goto failed
boot || goto failed

:failed
echo iPXE boot failed. Pausing 30 seconds...
sleep 30
