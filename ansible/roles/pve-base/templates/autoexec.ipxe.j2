#!ipxe
echo Booting Proxmox VE automated installer over HTTP...
kernel http://{{ cluster.boot_server_ip }}:8080/assets/linux26 initrd=initrd.img initrd=proxmox-iso.cpio ramdisk_size=16777216 vga=788 ip=any:dhcp quiet proxmox-start-auto-installer || goto failed
initrd http://{{ cluster.boot_server_ip }}:8080/assets/initrd.img initrd.img || goto failed
initrd http://{{ cluster.boot_server_ip }}:8080/assets/proxmox-iso.cpio proxmox-iso.cpio || goto failed
boot || goto failed

:failed
echo iPXE boot failed. Pausing 30 seconds...
sleep 30
