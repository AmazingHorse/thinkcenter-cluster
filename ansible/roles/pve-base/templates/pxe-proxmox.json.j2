{
  "id": "pxe-proxmox-{{ item.name }}",
  "name": "Proxmox VE {{ cluster.pve_version }} Unattended Install ({{ item.name }})",
  "ignition_id": "",
  "boot": {
    "kernel": "/assets/linux26",
    "initrd": [
      "/assets/initrd.img"
    ],
    "args": [
      "initrd=initrd.img",
      "vga=788",
      "proxmox-auto-install-answer-file-url=http://{{ cluster.boot_server_ip }}:8080/assets/answers/{{ item.name }}.toml",
      "proxmox-auto-install-answer-file-url-cert-fingerprint=",
      "quiet"
    ]
  }
}
