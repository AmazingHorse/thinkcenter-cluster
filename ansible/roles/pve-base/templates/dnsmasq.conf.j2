# Auto-generated from cluster-manifest.yml via Ansible 00-generate-boot-config.yml

interface=eth0
# Enable ProxyDHCP mode to co-exist with home router DHCP
dhcp-range={{ cluster.management_subnet | ansible.utils.ipaddr('net') | regex_replace('/.*$', '') }},proxy,255.255.255.0
dhcp-option=option:router,{{ cluster.management_gateway }}
dhcp-option=option:netmask,255.255.255.0
dhcp-option=option:dns-server,{{ cluster.management_gateway }}

{% for node in nodes %}
dhcp-host={{ node.mac }},{{ node.ip }},{{ node.name }}
{% endfor %}

enable-tftp
tftp-root=/var/lib/matchbox/assets

# ProxyDHCP PXE Services (only for initial PXE, not iPXE)
pxe-prompt="Booting Proxmox VE Cluster...", 1
pxe-service=tag:!ipxe,x86-64_EFI, "Proxmox VE Installer", snponly.efi
pxe-service=tag:!ipxe,6, "Proxmox VE Installer BC", snponly.efi
pxe-service=tag:!ipxe,X86PC, "Proxmox VE Installer Legacy", undionly.kpxe

# iPXE detection (Option 175 + User-Class)
dhcp-match=set:ipxe,175
dhcp-userclass=set:ipxe,iPXE
dhcp-userclass=set:ipxe,ipxe
dhcp-boot=tag:ipxe,http://{{ cluster.boot_server_ip }}:8080/boot.ipxe?mac=${net0/mac:hexhyp}
dhcp-option-force=tag:ipxe,67,http://{{ cluster.boot_server_ip }}:8080/boot.ipxe?mac=${net0/mac:hexhyp}
domain={{ cluster.domain }}
local=/{{ cluster.domain }}/
expand-hosts
log-queries
log-dhcp
log-facility=-
