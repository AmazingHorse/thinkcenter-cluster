# vault.sops.yaml.example — commit this file; do NOT commit vault.sops.yaml itself.
# Copy to vault.sops.yaml, fill in values, then encrypt with:
#   sops --encrypt --in-place ansible/secrets/vault.sops.yaml

proxmox_root_password: "CHANGE_ME_strong_password"
proxmox_api_token_id: "ansible@pam!automation"
proxmox_api_token_secret: "CHANGE_ME_uuid_token"
